# ─── LiveKit (the media server that carries audio & video) ───────────────────
# Easiest: create a free project at https://cloud.livekit.io and paste its
# URL, API key and secret here. Leave all three empty for local development —
# `npm run dev` then starts a LiveKit dev server on this machine for you.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: URL the Skypy server uses to reach LiveKit's API when it differs
# from LIVEKIT_URL (e.g. http://127.0.0.1:7880 when both run on one box).
# LIVEKIT_API_URL=

# ─── Skypy server ─────────────────────────────────────────────────────────────
# PORT=3000
# DATA_DIR=./data            # where rooms and seating charts are stored
# SEAT_GRACE_SECONDS=30      # how long a dropped connection keeps its seat
# ROOM_CREATE_LIMIT=30       # meetings one IP can create per hour
# CREATE_CODE=               # require this access code to START meetings (joining never needs it)
