{
  "name": "skypy",
  "version": "1.0.0",
  "private": true,
  "description": "Group video meetings where everyone keeps their seat — fixed seating, shared screens in the middle, every face stays on screen.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "livekit": "node scripts/livekit.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "share": "node scripts/share.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "livekit-server-sdk": "^2.19.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
